#!/bin/bash
# Temporary diagnostic for the opencode 2 e2e failure (PR #94).
# Usage: bin/debug-opencode-anchor <label> [VAR_TO_UNSET...]
# Boots a standalone opencode server in a fresh scenario dir and
# prints the directory it anchors on. Runs with a garbage model key:
# the run dies at provider auth, after the boot log names the
# directory.
set -u
label="$1"
shift

dir="$(mktemp -d)"
cat > "$dir/opencode.json" <<'EOF'
{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "simple-english": {"type": "local", "command": ["se", "mcp"]}
    }
  }
}
EOF
echo "test" > "$dir/note.md"

unset_args=()
for var in "$@"; do
  unset_args+=("$var")
done

echo "== $label: cwd=$dir unset=[${unset_args[*]-}]"
(
  cd "$dir"
  for var in "${unset_args[@]:-}"; do
    [ -n "$var" ] && unset "$var"
  done
  OPENAI_API_KEY=garbage timeout 60 opencode run --standalone \
    --print-logs --format json --model openai/gpt-4o "hi" 2>&1 \
    | grep -m1 -E "location services booted|directory="
) || echo "(run failed, no directory line found)"
