#!/usr/bin/env ruby
# frozen_string_literal: true

# CI resolves distribution community to this exact GraalVM Community
# build (GPLv2 with Classpath Exception). The script downloads the
# release artifact from graalvm/graalvm-ce-builds, checks its published
# SHA256, and unpacks it under GRAALVM_HOME (default ~/graalvm). An
# existing install is reused, so the script is safe to rerun. Bump
# VERSION when CI moves to a new CE build.

require "digest"
require "fileutils"
require "rbconfig"

module GraalvmSetup
  VERSION = "25.0.2"
  RELEASES = "https://github.com/graalvm/graalvm-ce-builds/releases/download/#{VERSION.tr(".", '-')}"
  NAME = "graalvm-community-jdk-#{VERSION}"

  module_function

  def run
    os, arch = host
    root = File.expand_path(ENV.fetch("GRAALVM_HOME", "~/graalvm"))
    install = Dir[File.join(root, "graalvm-community-openjdk-#{VERSION}*")].first
    install ||= download(os, arch, root)
    clear_quarantine(install) if os == "macos"
    java_home = install
    java_home = File.join(install, "Contents", "Home") if os == "macos"
    puts "GraalVM Community #{VERSION} is at #{java_home}"
    puts "Build with:"
    puts %(  JAVA_HOME="#{java_home}" bundle exec rake build)
  end

  def host
    case RbConfig::CONFIG["host_os"]
    when /darwin/ then ["macos", arch]
    when /linux/ then ["linux", arch]
    else abort "error: unsupported host. This script supports macOS and Linux."
    end
  end

  def arch
    return "aarch64" if RbConfig::CONFIG["host_cpu"].match?(/arm|aarch64/)

    "amd64"
  end

  def download(os, arch, root)
    FileUtils.mkdir_p(root)
    archive = File.join(root, "#{NAME}_#{os}-#{arch}_bin.tar.gz")
    system("curl", "-fL", "-o", archive, "#{RELEASES}/#{File.basename(archive)}", exception: true)
    checksum = `curl -fsSL #{RELEASES}/#{File.basename(archive)}.sha256`.strip.split.first
    actual = Digest::SHA256.file(archive).hexdigest
    abort "error: SHA256 mismatch. Expected #{checksum}, got #{actual}." unless actual == checksum
    system("tar", "-xzf", archive, "-C", root, exception: true)
    Dir[File.join(root, "graalvm-community-openjdk-#{VERSION}*")].first
  end

  # A downloaded archive carries the quarantine attribute, which
  # blocks the first launch on macOS.
  def clear_quarantine(install)
    system("xattr", "-r", "-d", "com.apple.quarantine", install,
      out: File::NULL, err: File::NULL)
  end
end

GraalvmSetup.run
