#!/usr/bin/env ruby
# frozen_string_literal: true

# Render the rule set as prose into docs/RULES.md: every pattern rule
# from rules/simple-english.xml (id, message, wrong and right example)
# and the counting rules with their limits. Run after every rule
# change and commit the result. test/run.rb fails when the file is
# stale.

require "rexml/document"
require_relative "../lib/simple_english/counts"

module RenderRules
  RULES_FILE = File.expand_path("../rules/simple-english.xml", __dir__)
  OUT_FILE = File.expand_path("../docs/RULES.md", __dir__)

  module_function

  def text_of(element)
    REXML::XPath.match(element, ".//text()").map(&:to_s).join
  end

  def example(element, type)
    text_of(element.elements["example[@type='#{type}']"])
  end

  def rule_section(element)
    <<~MD
      ### #{element.attributes["id"]}: #{element.attributes["name"]}

      #{text_of(element.elements["message"])}

      - Wrong: #{example(element, "incorrect")}
      - Right: #{example(element, "correct")}

    MD
  end

  def group_section(element)
    out = +"### #{element.attributes["id"]}: #{element.attributes["name"]}\n\n"
    element.each_element("rule") do |rule|
      out << "#### #{rule.attributes["name"]}\n\n"
      out << "#{text_of(rule.elements["message"])}\n\n"
      out << "- Wrong: #{example(rule, "incorrect")}\n"
      out << "- Right: #{example(rule, "correct")}\n\n"
    end
    out
  end

  def counting_section
    <<~MD
      ## Counting rules

      These rules run in Ruby on Markdown text. Code comments do not use
      them. Procedural text is a list item. Descriptive text is every
      other paragraph.

      ### SE_SENTENCE_TOO_LONG

      A sentence with more than #{SimpleEnglish::Counts::PROCEDURAL_WORD_LIMIT} words in
      procedural text, or more than #{SimpleEnglish::Counts::DESCRIPTIVE_WORD_LIMIT} words
      in descriptive text.

      ### SE_PARAGRAPH_TOO_LONG

      A paragraph with more than #{SimpleEnglish::Counts::PARAGRAPH_SENTENCE_LIMIT}
      sentences in descriptive text.
    MD
  end

  def render
    document = REXML::Document.new(File.read(RULES_FILE))
    out = +"# Rules\n\n"
    out << "Generated by `bin/render-rules`. Do not edit by hand. The source\n"
    out << "of truth is `rules/simple-english.xml` and\n"
    out << "`lib/simple_english/counts.rb`.\n\n"
    out << "## Pattern rules\n\n"
    document.elements["/rules/category"].each_element do |element|
      out << (element.name == "rulegroup" ? group_section(element) : rule_section(element))
    end
    out << counting_section << "\n"
  end
end

File.write(RenderRules::OUT_FILE, RenderRules.render) if $PROGRAM_NAME == __FILE__
